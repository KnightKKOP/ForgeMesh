# EditorConfig — https://editorconfig.org
# ForgeMesh 全仓库统一编辑器约定（Python / Go / Markdown / YAML / JSON / TOML）

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# ---- Python ----
[*.py]
indent_size = 4

# ---- Go（gofmt 强制 Tab 缩进）----
[*.go]
indent_style = tab
indent_size = 4

# ---- 数据/配置 ----
[*.{json,yaml,yml,toml}]
indent_size = 2

# ---- Go Module ----
[go.mod]
indent_style = tab

# ---- Web / 脚本 ----
[*.{js,jsx,ts,tsx,css,html,sh}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[LICENSE]
max_line_length = off